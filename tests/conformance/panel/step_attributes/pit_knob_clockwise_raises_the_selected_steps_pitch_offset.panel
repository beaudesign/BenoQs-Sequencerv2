# panel fixture: the PIT knob turned clockwise raises the selected step's pitch offset, one per detent
# manual: p015
# workflow: Step zoom, step attributes
given step 3 5 pit = 0
at 0 ms press mode.step
at 200 ms click step(3,5)
at 400 ms release mode.step
at 1000 ms turn edit.enc.pit 1
expect command SetStep track=3 step=4 attr=PitchOffset value=1
expect commands 1
expect engine step 3 5 pit = 1
at 1500 ms turn edit.enc.pit 2
expect engine step 3 5 pit = 3
