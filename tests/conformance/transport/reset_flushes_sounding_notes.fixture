# WENGE-0001 / SPEC-0001 A1, the Reset command. Same contract as Stop: the queue that held
# the pending NoteOff is cleared, so the engine must send the NoteOff itself.
seed 1
bpm 120
page.tracks 0 enabled
track 0 mch 1
track 0 step 0 len 192
play
# 14 buffers of 512 is 7,168 samples: the first step has fired and its note is far from over.
render 14 buffers buffer=512
expect event on port=1 ch=1 count=1
expect event off absent
reset
render 1 buffers buffer=512
expect event off port=1 ch=1 count=1 at=7168
expect event cc cc=123 port=1 ch=1 count=1
expect balance
