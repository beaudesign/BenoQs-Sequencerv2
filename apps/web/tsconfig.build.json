{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "spikes/**/*.ts",
    "pages/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "spikes/**/run.ts"
  ]
}
