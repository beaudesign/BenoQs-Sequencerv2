{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenge.local/contracts/controls.schema.json",
  "title": "Controls",
  "description": "The control inventory of the Octopus front panel, as the CE v5.30 manual describes it (ADR-0007). It holds what the manual says and nothing else: a control the manual does not settle is `pending` (a detail) or in `open` (a whole group), never a guess. No millimetres and no pixels: the web app's own layout file makes the design choices. Changed only by ADR; a hardware check that settles a question is a one-line amendment to ADR-0007.",
  "type": "object",
  "required": ["schema", "status", "source", "zones", "controls", "open"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "controls/1" },
    "status": {
      "enum": ["candidate", "ratified"],
      "description": "`candidate`: drafted from the manual. `ratified`: checked against an Octopus."
    },
    "source": { "type": "string", "minLength": 1 },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/zone" }
    },
    "relations": {
      "type": "array",
      "description": "Layout facts the manual states, each cited.",
      "items": { "$ref": "#/$defs/relation" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    },
    "open": {
      "type": "array",
      "description": "Groups of controls whose identity or count the manual leaves open. No `n`, no position. Each becomes controls by amendment when a hardware check settles it.",
      "items": { "$ref": "#/$defs/open_group" }
    }
  },

  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
    "page": { "type": "string", "pattern": "^p[0-9]{3}$" },
    "cite": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/page" },
      "description": "Manual pages (`reference/manual/pages/pNNN.txt`)."
    },
    "question": {
      "type": "string",
      "pattern": "^Q[0-9]{2}$",
      "description": "Q01 to Q20 are the items of specs/SPEC-0002/findings.md section 6, in order. Q21 onward are in tests/conformance/panel/QUESTIONS.md."
    },

    "zone": {
      "type": "object",
      "required": ["id", "name", "cite"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "grid": {
          "type": "object",
          "required": ["cols", "rows"],
          "additionalProperties": false,
          "properties": {
            "cols": { "type": "integer", "minimum": 1 },
            "rows": { "type": "integer", "minimum": 1 },
            "row_zero": { "enum": ["bottom", "top"] }
          }
        },
        "cite": { "$ref": "#/$defs/cite" },
        "note": { "type": "string" }
      }
    },

    "relation": {
      "type": "object",
      "required": ["a", "relation", "b", "cite"],
      "additionalProperties": false,
      "properties": {
        "a": { "type": "string" },
        "relation": { "enum": ["left_of", "right_of", "above", "below"] },
        "b": { "type": "string" },
        "cite": { "$ref": "#/$defs/cite" }
      }
    },

    "control": {
      "type": "object",
      "required": ["n", "id", "kind", "zone", "name", "cite"],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511,
          "description": "The ControlId. Unique, assigned once, never reused, never renumbered. 511 is the engine's MAX_CONTROLS minus one."
        },
        "id": {
          "$ref": "#/$defs/name",
          "description": "Dotted lower-case name. Renaming is an ADR."
        },
        "kind": { "enum": ["button", "encoder", "display"] },
        "zone": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1, "description": "The manual's own name for the control, as printed." },
        "unnamed": { "const": true, "description": "The manual does not name this control; `name` describes it." },
        "label": { "type": "string", "description": "What is printed on the panel, such as a Roman numeral." },
        "at": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "Position in the zone's own grid, in the manual's numbers: matrix columns are steps 1 to 16, rows are 0 to 9. `index` is the manual's own ordinal in a list.",
          "properties": {
            "col": { "type": "integer", "minimum": 1 },
            "row": { "type": "integer", "minimum": 0 },
            "index": { "type": "integer", "minimum": 1 }
          }
        },
        "led": { "type": "boolean" },
        "push": { "type": "boolean", "description": "An encoder with a push switch." },
        "cite": { "$ref": "#/$defs/cite" },
        "pending": {
          "type": "object",
          "required": ["question", "note"],
          "additionalProperties": false,
          "properties": {
            "question": { "$ref": "#/$defs/question" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "open_group": {
      "type": "object",
      "required": ["id", "zone", "names", "question", "note", "cite"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "zone": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "question": { "$ref": "#/$defs/question" },
        "note": { "type": "string", "minLength": 1 },
        "cite": { "$ref": "#/$defs/cite" }
      }
    }
  }
}
