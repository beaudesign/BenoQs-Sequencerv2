{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenge.local/contracts/design.tokens.schema.json",
  "title": "Design tokens",
  "description": "The web panel's colours, space, type, strokes and LED flash, as one file the app's stylesheet is generated from (ADR-0008 decision 6). It has no shadow, gradient or easing group and no radius scale (one corner, the control's), so the slop rules S1, S4, S9 and S16 have nothing to be satisfied by and S15 has one value. The only saturated colour is a lit LED; the two materials of the hardware, plate and frame, are tinted under a chroma ceiling and carry an exemption that expires (ADR-0010); every other colour is pure grey (the rules are asserted by apps/web/engine/tests/tokens.rs). A token whose value depends on something the manual does not say carries `pending`, the shape `controls.json` uses. Changed only by ADR.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "colour",
    "radius",
    "space",
    "type",
    "stroke",
    "flash"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Where this file's schema is, for editors."
    },
    "schema": {
      "const": "design.tokens/1"
    },
    "status": {
      "enum": [
        "candidate",
        "ratified"
      ],
      "description": "`candidate`: proposed with the panel sketch, awaiting the owner. `ratified`: the owner has merged it."
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "colour": {
      "type": "object",
      "required": [
        "led.red",
        "led.green",
        "led.orange",
        "led.off",
        "ink",
        "ink.quiet",
        "surface",
        "focus",
        "focus.inner",
        "plate",
        "frame",
        "plate.ink",
        "plate.ink.quiet",
        "key",
        "key.edge",
        "surface.raised",
        "edge",
        "edge.control"
      ],
      "additionalProperties": false,
      "description": "Eighteen roles and no nineteenth: the nine of ADR-0008, the six of ADR-0010 and the three of ADR-0011. The three led roles are roles and not hues: the manual's other colourways (p004) are a later table that maps a role to a hue. `plate` and `frame` are the hardware's materials; `plate.ink`, `plate.ink.quiet`, `key` and `key.edge` are pure grey and the panel's; `surface.raised`, `edge` and `edge.control` are pure grey and the strip's.",
      "properties": {
        "led.red": {
          "$ref": "#/$defs/colour_token"
        },
        "led.green": {
          "$ref": "#/$defs/colour_token"
        },
        "led.orange": {
          "$ref": "#/$defs/colour_token"
        },
        "led.off": {
          "$ref": "#/$defs/colour_token"
        },
        "ink": {
          "$ref": "#/$defs/colour_token"
        },
        "ink.quiet": {
          "$ref": "#/$defs/colour_token"
        },
        "surface": {
          "$ref": "#/$defs/colour_token"
        },
        "focus": {
          "$ref": "#/$defs/colour_token"
        },
        "focus.inner": {
          "$ref": "#/$defs/colour_token"
        },
        "plate": {
          "$ref": "#/$defs/colour_token"
        },
        "frame": {
          "$ref": "#/$defs/colour_token"
        },
        "plate.ink": {
          "$ref": "#/$defs/colour_token"
        },
        "plate.ink.quiet": {
          "$ref": "#/$defs/colour_token"
        },
        "key": {
          "$ref": "#/$defs/colour_token"
        },
        "key.edge": {
          "$ref": "#/$defs/colour_token"
        },
        "surface.raised": {
          "$ref": "#/$defs/colour_token"
        },
        "edge": {
          "$ref": "#/$defs/colour_token"
        },
        "edge.control": {
          "$ref": "#/$defs/colour_token"
        }
      }
    },
    "radius": {
      "type": "object",
      "required": [
        "control"
      ],
      "additionalProperties": false,
      "description": "One corner, a control's (ADR-0011 decision 6). It is not a scale: docs/05 section 2.3 still has none, and the panel's controls are circles (50%). apps/web/engine/tests/tokens.rs T10 keeps it to one value between 1 and 12.",
      "properties": {
        "control": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "required": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ],
      "additionalProperties": false,
      "description": "docs/05 section 2.2: base 4, eight values. If you need a ninth, you are designing a ninth thing.",
      "properties": {
        "0": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 0
            }
          }
        },
        "1": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 4
            }
          }
        },
        "2": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 8
            }
          }
        },
        "3": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 12
            }
          }
        },
        "4": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 20
            }
          }
        },
        "5": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 32
            }
          }
        },
        "6": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 52
            }
          }
        },
        "7": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 84
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "required": [
        "family",
        "face",
        "weight",
        "size",
        "measure"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "object",
          "required": [
            "value",
            "pending"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        },
        "face": {
          "type": "object",
          "required": [
            "name",
            "file",
            "licence",
            "features"
          ],
          "additionalProperties": false,
          "description": "The family's lead name as a file in the repository, so that naming it is not a promise about what the visitor has installed (T17). The stylesheet generator writes the @font-face from it.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "pattern": "^pages/fonts/[A-Za-z0-9._-]+\\.woff2$",
              "description": "Relative to apps/web; a variable font in woff2."
            },
            "licence": {
              "type": "string",
              "pattern": "^pages/fonts/[A-Za-z0-9._-]+\\.txt$",
              "description": "The licence text, beside the file."
            },
            "features": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{4}$"
              },
              "description": "OpenType feature tags the page turns on."
            }
          }
        },
        "weight": {
          "type": "object",
          "required": [
            "regular",
            "strong"
          ],
          "additionalProperties": false,
          "description": "Emphasis is made with weight and not with bold: strong is under 700 (T18).",
          "properties": {
            "regular": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                }
              }
            },
            "strong": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                }
              }
            }
          }
        },
        "size": {
          "type": "object",
          "required": [
            "label",
            "body"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 48
                },
                "pending": {
                  "$ref": "#/$defs/pending"
                }
              }
            },
            "body": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 48
                },
                "pending": {
                  "$ref": "#/$defs/pending"
                }
              }
            }
          }
        },
        "measure": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 68
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        }
      }
    },
    "stroke": {
      "type": "object",
      "required": [
        "hairline",
        "focus",
        "focus_inner"
      ],
      "additionalProperties": false,
      "description": "Line widths. docs/05 section 5 sets the focus ring at 2 px with a 1 px contrasting inner stroke, and neither is on the space scale (ADR-0008 amendment 2).",
      "properties": {
        "hairline": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "const": 1
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        },
        "focus": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        },
        "focus_inner": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        }
      }
    },
    "flash": {
      "type": "object",
      "required": [
        "period_ms",
        "duty_percent",
        "shine"
      ],
      "additionalProperties": false,
      "description": "The LED flash is information and not decoration (docs/05 section 3). The manual does not give its rate or what shine looks like, so each token says so.",
      "properties": {
        "period_ms": {
          "type": "object",
          "required": [
            "value",
            "pending"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "finding": {
              "type": "string",
              "minLength": 1,
              "description": "Set only if the manual's rate reaches three flashes a second: then the rate is a finding for the owner (WCAG 2.3.1) and not a reason to slow the language down silently."
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        },
        "duty_percent": {
          "type": "object",
          "required": [
            "value",
            "pending"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 10,
              "maximum": 90
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        },
        "shine": {
          "type": "object",
          "required": [
            "value",
            "pending"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "ink",
                "ink.quiet"
              ],
              "description": "Which neutral the shine state is drawn from: the lit colour with a ring in this colour. Never a new colour (Q03)."
            },
            "pending": {
              "$ref": "#/$defs/pending"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pending": {
      "type": "object",
      "required": [
        "question",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "colour_token": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "pending": {
          "$ref": "#/$defs/pending"
        },
        "suppress": {
          "type": "array",
          "description": "Rule S8's own exit: a colour near the AI-design cluster says why it is there.",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "const": "S8"
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exemption": {
          "type": "object",
          "description": "Rule T7's exemption (ADR-0010 decision 5): a tinted material says why, and until when. Only plate and frame may carry one (apps/web/engine/tests/tokens.rs).",
          "required": [
            "rule",
            "why",
            "expires"
          ],
          "additionalProperties": false,
          "properties": {
            "rule": {
              "const": "T7"
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "expires": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    }
  }
}
