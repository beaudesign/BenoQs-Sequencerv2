{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenge.local/contracts/motion.registry.schema.json",
  "title": "Motion Registry",
  "description": "Every animated quantity in the product, declared as a physical model. No animation may exist that is not registered here, and no animation may be authored as a bezier or easing keyword. verify:motion captures each transition offline, measures the animated quantity from the rendered frames, independently integrates the declared model, and fails if they diverge beyond tolerance. This is the mechanism behind 'flawless frame to frame': not that someone looked at it, but that the pixels provably follow the declared physics.",
  "type": "object",
  "required": ["schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "motion.registry/1" },

    "springs": {
      "type": "object",
      "description": "The three shell spring presets. Adding a fourth requires an ADR.",
      "additionalProperties": {
        "type": "object",
        "required": ["omega", "zeta"],
        "additionalProperties": false,
        "properties": {
          "omega": { "type": "number", "exclusiveMinimum": 0, "description": "Undamped natural frequency, rad/s." },
          "zeta": { "type": "number", "minimum": 0, "description": "Damping ratio. 1.0 is critically damped." },
          "settle_ms": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string" }
        }
      }
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model", "params", "measurement", "tolerance"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$",
            "description": "e.g. 'button.press', 'encoder.turn', 'led.red', 'shell.dropdown.reveal', 'room.probe.crossfade'."
          },
          "applies_to": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Control ids or id glob patterns from panel.truth.json, e.g. 'matrix.*'. Empty means shell-only."
          },
          "model": {
            "enum": [
              "mass_spring_damper",
              "rotational_detent",
              "first_order_asymmetric",
              "spring_preset",
              "linear_crossfade"
            ]
          },
          "params": {
            "type": "object",
            "description": "Model-specific. See allOf below for per-model requirements.",
            "additionalProperties": true
          },
          "measurement": {
            "type": "object",
            "required": ["method", "quantity"],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": ["centroid_track", "mask_mean_luminance", "turning_mark_angle", "probe_lerp_weight", "region_alpha"],
                "description": "How verify:motion recovers the animated quantity from rendered frames."
              },
              "quantity": { "type": "string", "description": "e.g. 'press_depth_mm', 'intensity_0_1', 'angle_rad'." },
              "region": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" },
                "description": "[x, y, w, h] in the captured frame, for masked measurements."
              },
              "capture_scene": { "type": "string", "description": "Scene name in harness/capture/scenes.toml." },
              "capture_rate_hz": { "type": "number", "default": 240 }
            }
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "curve_rmse": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 0.01,
                "description": "RMSE between the rendered curve and the independently integrated model, as a fraction of the quantity's range. Default 1%."
              },
              "position_mm": { "type": "number", "exclusiveMinimum": 0 },
              "monotonic_where_model_is": { "type": "boolean", "default": true },
              "max_static_jitter_px": { "type": "number", "default": 0.02, "description": "Drift permitted on elements that should be static during this transition." }
            }
          },
          "settle_ms": { "type": "number", "exclusiveMinimum": 0 },
          "reduced_motion": {
            "enum": ["instant", "shortened", "unchanged"],
            "default": "instant",
            "description": "Behaviour under prefers-reduced-motion."
          },
          "rationale": {
            "type": "string",
            "description": "Why these parameters. For example: buttons are set slightly underdamped at zeta 0.7 because real tactile switches overshoot faintly on release. Nobody consciously notices it; everybody notices its absence."
          }
        },

        "allOf": [
          {
            "if": { "properties": { "model": { "const": "mass_spring_damper" } } },
            "then": {
              "properties": {
                "params": {
                  "required": ["m", "k", "zeta", "travel_mm"],
                  "properties": {
                    "m": { "type": "number", "exclusiveMinimum": 0 },
                    "k": { "type": "number", "exclusiveMinimum": 0 },
                    "zeta": { "type": "number", "minimum": 0 },
                    "travel_mm": { "type": "number", "exclusiveMinimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "model": { "const": "rotational_detent" } } },
            "then": {
              "properties": {
                "params": {
                  "required": ["inertia", "damping", "detent_amplitude", "detents_per_rev"],
                  "properties": {
                    "inertia": { "type": "number", "exclusiveMinimum": 0 },
                    "damping": { "type": "number", "minimum": 0 },
                    "detent_amplitude": { "type": "number", "minimum": 0, "description": "A in tau_detent = -A sin(N theta)." },
                    "detents_per_rev": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "model": { "const": "first_order_asymmetric" } } },
            "then": {
              "properties": {
                "params": {
                  "required": ["tau_rise_ms", "tau_decay_ms"],
                  "properties": {
                    "tau_rise_ms": { "type": "number", "exclusiveMinimum": 0 },
                    "tau_decay_ms": { "type": "number", "exclusiveMinimum": 0 },
                    "integration": {
                      "const": "exact_exponential",
                      "description": "Must be an exact exponential step, never an Euler step, so the result is frame-rate independent and identical at 120 Hz live and 240 Hz offline. verify:motion depends on this."
                    }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "model": { "const": "spring_preset" } } },
            "then": {
              "properties": {
                "params": {
                  "required": ["preset"],
                  "properties": { "preset": { "enum": ["tap", "reveal", "world"] } }
                }
              }
            }
          }
        ]
      }
    }
  }
}
