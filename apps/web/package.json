{
  "name": "wenge-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The WENGE web sequencer: the engine in an AudioWorklet and Web MIDI out (SPEC-0002 P3, ADR-0008). Owner: Forge.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-css.ts && tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "npm run build && node --test --test-concurrency=1 \"test/browser/*.test.ts\"",
    "spike:s2": "npm run build && node spikes/s2/run.ts",
    "spike:s1": "npm run build && node spikes/s1/run.ts",
    "app": "npm run build && node scripts/app.ts",
    "screenshot": "npm run build && node scripts/screenshot.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "playwright-core": "1.56.0",
    "typescript": "5.9.3"
  }
}
